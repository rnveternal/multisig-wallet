# RPC endpoint for the chain your wallet is deployed on
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your-key

# Address of your deployed MultiSigWallet contract
WALLET_ADDRESS=0xYourDeployedMultiSigAddress

# Private key of the EOA used for `sign` (must be one of the 5 owners)
# and/or `execute` (can be ANY funded account, not necessarily an owner —
# it only pays gas, the on-chain check verifies owner signatures).
# NEVER commit your real .env file.
SIGNER_PRIVATE_KEY=0xyourprivatekey
